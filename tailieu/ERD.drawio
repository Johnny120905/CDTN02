        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam linetype ortho\nskinparam backgroundColor #FFFFFF\nskinparam classAttributeIconSize 0\nhide stereotype\n\n&#39; --- PHÂN HỆ QUẢN TRỊ VIÊN &amp; DÙNG CHUNG (Admin / Global) ---\nentity \&quot;Users\&quot; as users #F19373 {\n  * _id : ObjectId &lt;&lt;PK&gt;&gt;\n  --\n  email : string\n  password_hash : string\n  role : string\n  status : string\n  is_banned : boolean\n  ban_reason : string\n  otp_code : string\n  otp_expires_at : datetime\n  created_at : datetime\n}\n\nentity \&quot;Notifications\&quot; as notifications #AFD788 {\n  * _id : ObjectId &lt;&lt;PK&gt;&gt;\n  --\n  user_id : ObjectId &lt;&lt;FK&gt;&gt;\n  title : string\n  message : string\n  type : string\n  related_id : ObjectId\n  is_read : boolean\n  is_deleted : boolean\n  created_at : datetime\n}\n\nentity \&quot;Reports\&quot; as reports #AFD788 {\n  * _id : ObjectId &lt;&lt;PK&gt;&gt;\n  --\n  reporter_id : ObjectId &lt;&lt;FK&gt;&gt;\n  report_type : string\n  target_id : ObjectId\n  reason : string\n  status : string\n  created_at : datetime\n}\n\nentity \&quot;Categories\&quot; as categories #AFD788 {\n  * _id : ObjectId &lt;&lt;PK&gt;&gt;\n  --\n  name : string\n  type : string\n  is_active : boolean\n}\n\n\nentity \&quot;Banned_Keywords\&quot; as banned_keywords #AFD788 {\n  * _id : ObjectId &lt;&lt;PK&gt;&gt;\n  --\n  keyword : string\n  created_at : datetime\n}\n\n&#39; --- PHÂN HỆ SINH VIÊN (Student) ---\nentity \&quot;Student_Profiles\&quot; as student_profiles #FEF889 {\n  * _id : ObjectId &lt;&lt;PK&gt;&gt;\n  --\n  user_id : ObjectId &lt;&lt;FK&gt;&gt;\n  full_name : string\n  phone : string\n  university : string\n  major : string\n}\n\nentity \&quot;Cover_Letters\&quot; as cover_letters #FEF889 {\n  * _id : ObjectId &lt;&lt;PK&gt;&gt;\n  --\n  student_id : ObjectId &lt;&lt;FK&gt;&gt;\n  title : string\n  content : string\n  created_at : datetime\n}\n\nentity \&quot;Resumes\&quot; as resumes #FEF889 {\n  * _id : ObjectId &lt;&lt;PK&gt;&gt;\n  --\n  student_id : ObjectId &lt;&lt;FK&gt;&gt;\n  file_url : string\n  is_default : boolean\n  created_at : datetime\n}\n\nentity \&quot;Bookmarks\&quot; as bookmarks #67BF7F {\n  * _id : ObjectId &lt;&lt;PK&gt;&gt;\n  --\n  student_id : ObjectId &lt;&lt;FK&gt;&gt;\n  job_id : ObjectId &lt;&lt;FK&gt;&gt;\n  created_at : datetime\n}\n\n\n&#39; --- PHÂN HỆ NHÀ TUYỂN DỤNG (Employer) ---\nentity \&quot;Employers\&quot; as employers #F9CC76 {\n  * _id : ObjectId &lt;&lt;PK&gt;&gt;\n  --\n  user_id : ObjectId &lt;&lt;FK&gt;&gt;\n  approval_status : string\n  reject_reason : string\n}\n\nentity \&quot;Company_Profiles\&quot; as company_profiles #F9CC76 {\n  * _id : ObjectId &lt;&lt;PK&gt;&gt;\n  --\n  employer_id : ObjectId &lt;&lt;FK&gt;&gt;\n  company_name : string\n  description : string\n  scale : string\n  address : string\n  business_license_url : string\n  logo_url : string\n  cover_image_url : string\n}\n\nentity \&quot;Jobs\&quot; as jobs #F9CC76 {\n  * _id : ObjectId &lt;&lt;PK&gt;&gt;\n  --\n  employer_id : ObjectId &lt;&lt;FK&gt;&gt;\n  category_id : ObjectId &lt;&lt;FK&gt;&gt;\n  location_id : ObjectId &lt;&lt;FK&gt;&gt;\n  title : string\n  description : string\n  salary_min : Decimal128\n  salary_max : Decimal128\n  is_negotiable : boolean\n  work_time : string\n  job_status : string\n  is_open : boolean\n  is_hidden : boolean\n  hidden_reason : string\n  created_at : datetime\n}\n\n\n&#39; --- CÁC BẢNG TƯƠNG TÁC GIAO THƯA (Giao tiếp giữa SV &amp; NTD) ---\nentity \&quot;Applications\&quot; as applications #67BF7F {\n  * _id : ObjectId &lt;&lt;PK&gt;&gt;\n  --\n  job_id : ObjectId &lt;&lt;FK&gt;&gt;\n  student_id : ObjectId &lt;&lt;FK&gt;&gt;\n  application_status : string\n  reject_reason : string\n  application_snapshot : object\n  status_history : array\n  applied_at : datetime\n}\n\nentity \&quot;Reviews\&quot; as reviews #67BF7F {\n  * _id : ObjectId &lt;&lt;PK&gt;&gt;\n  --\n  application_id : ObjectId &lt;&lt;FK&gt;&gt;\n  reviewer_id : ObjectId &lt;&lt;FK&gt;&gt;\n  target_id : ObjectId &lt;&lt;FK&gt;&gt;\n  rating : int\n  comment : string\n  is_hidden : boolean\n  created_at : datetime\n}\n\nentity \&quot;Chat_Rooms\&quot; as chat_rooms #67BF7F {\n  * _id : ObjectId &lt;&lt;PK&gt;&gt;\n  --\n  student_id : ObjectId &lt;&lt;FK&gt;&gt;\n  employer_id : ObjectId &lt;&lt;FK&gt;&gt;\n  status : string\n  created_at : datetime\n}\n\nentity \&quot;Messages\&quot; as messages #67BF7F {\n  * _id : ObjectId &lt;&lt;PK&gt;&gt;\n  --\n  room_id : ObjectId &lt;&lt;FK&gt;&gt;\n  sender_id : ObjectId &lt;&lt;FK&gt;&gt;\n  content : string\n  media_url : string\n  message_status : string\n  created_at : datetime\n}\n\n\n&#39; --- Relationships ---\nusers ||--o| student_profiles : \&quot;1-1 (Student)\&quot;\nusers ||--o| employers : \&quot;1-1 (Employer)\&quot;\nusers ||--o{ messages : \&quot;1-N (sender)\&quot;\nusers ||--o{ reviews : \&quot;1-N (reviewer)\&quot;\nusers ||--o{ reviews : \&quot;1-N (target)\&quot;\nusers ||--o{ notifications : \&quot;1-N\&quot;\nusers ||--o{ reports : \&quot;1-N\&quot;\n\ncategories ||--o{ jobs : \&quot;1-N (Ngành nghề)\&quot;\ncategories ||--o{ jobs : \&quot;1-N (Địa điểm)\&quot;\n\nstudent_profiles ||--o{ cover_letters : \&quot;1-N\&quot;\nstudent_profiles ||--o{ resumes : \&quot;1-N\&quot;\nstudent_profiles ||--o{ applications : \&quot;1-N\&quot;\nstudent_profiles ||--o{ bookmarks : \&quot;1-N\&quot;\nstudent_profiles ||--o{ chat_rooms : \&quot;1-N\&quot;\n\nemployers ||--|| company_profiles : \&quot;1-1\&quot;\nemployers ||--o{ chat_rooms : \&quot;1-N\&quot;\nemployers ||--o{ jobs : \&quot;1-N\&quot;\n\njobs ||--o{ applications : \&quot;1-N\&quot;\njobs ||--o{ bookmarks : \&quot;1-N\&quot;\n\napplications ||--o{ reviews : \&quot;1-N (tối đa 2)\&quot;\n\nchat_rooms ||--o{ messages : \&quot;1-N\&quot;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Oa79KAMh1NGogk5YYfA_-2">
