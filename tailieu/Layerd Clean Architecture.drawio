<mxfile host="app.diagrams.net">
  <diagram name="Layered Clean Architecture" id="LayeredCleanArchitecture02">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;: &quot;@startuml\nskinparam linetype ortho\nskinparam backgroundColor #FFFFFF\nskinparam defaultFontName \&quot;Be Vietnam Pro, Segoe UI, sans-serif\&quot;\nskinparam defaultFontSize 11\nskinparam roundCorner 8\nskinparam shadowing false\n\nskinparam package {\n  BackgroundColor #F8FAFC\n  BorderColor #64748B\n  FontColor #0F172A\n  FontSize 12\n  FontStyle bold\n}\n\n&#x27; ==========================================\n&#x27; T\u1ea6NG 1: PRESENTATION LAYER (GIAO DI\u1ec6N &amp; T\u01af\u01a0NG T\u00c1C 3D)\n&#x27; ==========================================\npackage \&quot;T\u1ea6NG 1: TR\u00ccNH B\u00c0Y (PRESENTATION LAYER) - ReactJS + Vite + Tailwind CSS + Three.js 3D\&quot; as L1 #ECFDF5 {\n  rectangle \&quot;Ph\u00e2n h\u1ec7 SINH VI\u00caN (Student Portal)\\n&lt;b&gt;Ph\u1ee5 tr\u00e1ch: V\u0169 Th\u1ebf Long&lt;/b&gt;\\n- 3D Interactive Hero &amp; PARTIME Logo\\n- T\u00ecm ki\u1ebfm &amp; L\u1ecdc vi\u1ec7c l\u00e0m (FR 1.5)\\n- Qu\u1ea3n l\u00fd H\u1ed3 s\u01a1, CV, Th\u01b0 xin vi\u1ec7c (FR 1.3, 1.4)\\n- Theo d\u00f5i ti\u1ebfn \u0111\u1ed9 \u1ee9ng tuy\u1ec3n (FR 1.6)\\n- \u0110\u00e1nh gi\u00e1 NTD &amp; Chat Realtime, Video Call (FR 1.7-1.10)\&quot; as UI_Student #FEF08A\n  \n  rectangle \&quot;Ph\u00e2n h\u1ec7 NH\u00c0 TUY\u1ec2N D\u1ee4NG (Employer Portal)\\n&lt;b&gt;Ph\u1ee5 tr\u00e1ch: Hu\u1ef3nh Nguy\u1ec5n B\u1ea3o Ng\u1ecdc&lt;/b&gt;\\n- Qu\u1ea3n l\u00fd h\u1ed3 s\u01a1 c\u00f4ng ty &amp; GPKD (FR 2.3)\\n- \u0110\u0103ng &amp; qu\u1ea3n l\u00fd tin tuy\u1ec3n d\u1ee5ng (FR 2.4)\\n- Qu\u1ea3n l\u00fd &amp; duy\u1ec7t \u1ee9ng vi\u00ean, xem CV (FR 2.5)\\n- \u0110\u00e1nh gi\u00e1 sinh vi\u00ean &amp; Chat, Video Call (FR 2.6-2.9)\&quot; as UI_Employer #FED7AA\n  \n  rectangle \&quot;Ph\u00e2n h\u1ec7 QU\u1ea2N TR\u1eca VI\u00caN (Admin Portal)\\n&lt;b&gt;Ph\u1ee5 tr\u00e1ch: L\u00ea Th\u1ecb Thu\u1ef3 Ng\u00e2n&lt;/b&gt;\\n- Dashboard th\u1ed1ng k\u00ea &amp; T\u0103ng tr\u01b0\u1edfng (FR 3.3)\\n- Qu\u1ea3n l\u00fd ng\u01b0\u1eddi d\u00f9ng: Kh\u00f3a/M\u1edf kh\u00f3a (FR 3.4)\\n- Ki\u1ec3m duy\u1ec7t tin tuy\u1ec3n d\u1ee5ng (FR 3.5)\\n- Qu\u1ea3n l\u00fd \u0111\u00e1nh gi\u00e1 ch\u00e9o &amp; B\u00e1o c\u00e1o vi ph\u1ea1m (FR 3.6, 3.8)\\n- Danh m\u1ee5c ng\u00e0nh &amp; B\u1ed9 l\u1ecdc t\u1eeb c\u1ea5m t\u1ef1 \u0111\u1ed9ng (FR 3.7, 3.9)\&quot; as UI_Admin #FECDD3\n}\n\n&#x27; ==========================================\n&#x27; T\u1ea6NG 2: CONTROLLER &amp; API GATEWAY LAYER\n&#x27; ==========================================\npackage \&quot;T\u1ea6NG 2: \u0110I\u1ec0U PH\u1ed0I &amp; \u0110\u1ecaNH TUY\u1ebeN (CONTROLLER &amp; GATEWAY LAYER) - Flask Blueprints\&quot; as L2 #F0FDF4 {\n  rectangle \&quot;Middleware x\u00e1c th\u1ef1c &amp; R\u00e0ng bu\u1ed9c:\\n- JWT Token Validation\\n- RBAC (Role-Based Access Control)\\n- &lt;b&gt;R\u00e0ng bu\u1ed9c nghi\u00eam ng\u1eb7t 1 Email = 1 Role duy nh\u1ea5t&lt;/b&gt;\\n- Request Validation (Pydantic / Schema)\&quot; as MW #E2E8F0\n  \n  rectangle \&quot;Student Controller (/api/student/*)\\n- profile_routes.py\\n- resume_routes.py\\n- job_search_routes.py\\n- apply_routes.py\\n- review_routes.py\&quot; as C_Student #FEF9C3\n  \n  rectangle \&quot;Employer Controller (/api/employer/*)\\n- company_routes.py\\n- job_manage_routes.py\\n- applicant_routes.py\\n- review_routes.py\&quot; as C_Employer #FFEDD5\n  \n  rectangle \&quot;Admin Controller (/api/admin/*)\\n- dashboard_routes.py\\n- user_admin_routes.py\\n- job_admin_routes.py\\n- category_routes.py\\n- report_admin_routes.py\\n- banned_keyword_routes.py\&quot; as C_Admin #FFE4E6\n  \n  rectangle \&quot;Realtime Gateway &amp; Auth (/api/auth/*, Socket.IO)\\n- auth_routes.py (\u0110\u0103ng k\u00fd, \u0110\u0103ng nh\u1eadp, OTP Email th\u1eadt)\\n- chat_socket.py (Online, \u0110ang g\u00f5, \u0110\u00e3 xem, G\u1eedi file)\\n- webrtc_signaling.py (Call Offer / Answer / ICE)\&quot; as C_Shared #E0E7FF\n}\n\n&#x27; ==========================================\n&#x27; T\u1ea6NG 3: APPLICATION &amp; BUSINESS LOGIC LAYER (SERVICES)\n&#x27; ==========================================\npackage \&quot;T\u1ea6NG 3: NGHI\u1ec6P V\u1ee4 H\u1ec6 TH\u1ed0NG (APPLICATION &amp; BUSINESS LOGIC LAYER)\&quot; as L3 #F8FAFC {\n  rectangle \&quot;Student Services (V\u0169 Th\u1ebf Long)\\n- StudentProfileService\\n- ResumeService\\n- JobMatchingService\\n- ApplicationWorkflowService\\n- StudentReviewService\&quot; as S_Student #FEF08A\n  \n  rectangle \&quot;Employer Services (Hu\u1ef3nh Nguy\u1ec5n B\u1ea3o Ng\u1ecdc)\\n- CompanyProfileService\\n- JobLifecycleService\\n- ApplicantScreeningService\\n- EmployerReviewService\&quot; as S_Employer #FED7AA\n  \n  rectangle \&quot;Admin Services (L\u00ea Th\u1ecb Thu\u1ef3 Ng\u00e2n)\\n- StatisticsAnalyticsService\\n- UserModerationService\\n- JobModerationService\\n- MasterCategoryService\\n- ReportHandlingService\\n- KeywordFilterService\&quot; as S_Admin #FECDD3\n  \n  rectangle \&quot;Core Shared Services\\n- AuthService (X\u00e1c th\u1ef1c Email duy nh\u1ea5t, OTP m\u00e3 h\u00f3a bcrypt)\\n- RealtimeChatService (L\u01b0u message, l\u1ecdc t\u1eeb c\u1ea5m t\u1ef1 \u0111\u1ed9ng)\\n- NotificationService (Th\u00f4ng b\u00e1o h\u1ec7 th\u1ed1ng / \u1ee9ng tuy\u1ec3n)\\n- MediaUploadService (X\u00e1c th\u1ef1c dung l\u01b0\u1ee3ng &amp; MIME type)\&quot; as S_Shared #E0E7FF\n}\n\n&#x27; ==========================================\n&#x27; T\u1ea6NG 4: DATA ACCESS / REPOSITORY LAYER\n&#x27; ==========================================\npackage \&quot;T\u1ea6NG 4: TRUY XU\u1ea4T D\u1eee LI\u1ec6U (DATA ACCESS / REPOSITORY LAYER)\&quot; as L4 #F1F5F9 {\n  rectangle \&quot;Student Repositories:\\n- StudentProfileRepo\\n- ResumeRepo\\n- CoverLetterRepo\\n- BookmarkRepo\&quot; as R_Student #FEF9C3\n  \n  rectangle \&quot;Employer Repositories:\\n- EmployerRepo\\n- CompanyProfileRepo\\n- JobRepo\&quot; as R_Employer #FFEDD5\n  \n  rectangle \&quot;Admin Repositories:\\n- CategoryRepo\\n- ReportRepo\\n- BannedKeywordRepo\&quot; as R_Admin #FFE4E6\n  \n  rectangle \&quot;Shared Repositories:\\n- UserRepo (Index Unique Email)\\n- ApplicationRepo (Status history &amp; Snapshot)\\n- ReviewRepo (Kh\u00f3a \u0111\u00e1nh gi\u00e1 ch\u00e9o)\\n- ChatRoomRepo &amp; MessageRepo\\n- NotificationRepo\&quot; as R_Shared #E0E7FF\n}\n\n&#x27; ==========================================\n&#x27; T\u1ea6NG 5: INFRASTRUCTURE &amp; STORAGE LAYER\n&#x27; ==========================================\npackage \&quot;T\u1ea6NG 5: H\u1ea0 T\u1ea6NG &amp; L\u01afU TR\u1eee (INFRASTRUCTURE &amp; PERSISTENCE LAYER)\&quot; as L5 #ECFDF5 {\n  database \&quot;MongoDB Atlas (Database: CDTN02_DB)\\n&lt;b&gt;16 Collections chung:&lt;/b&gt;\\n- users, student_profiles, employers\\n- company_profiles, cover_letters, resumes\\n- jobs, categories, bookmarks, applications\\n- reviews, chat_rooms, messages, notifications\\n- reports, banned_keywords\&quot; as DB #BBF7D0\n  \n  cloud \&quot;Cloud Storage (Cloudinary)\\n- L\u01b0u tr\u1eef CV (PDF)\\n- Gi\u1ea5y ph\u00e9p kinh doanh (PDF)\\n- \u1ea2nh \u0111\u1ea1i di\u1ec7n, Logo, \u1ea2nh b\u00eca (PNG/JPG)\\n- File \u0111\u00ednh k\u00e8m trong Chat\&quot; as CloudFiles #BFDBFE\n  \n  node \&quot;D\u1ecbch v\u1ee5 Email Th\u1ef1c (SMTP Provider)\\n- G\u1eedi m\u00e3 OTP x\u00e1c th\u1ef1c t\u00e0i kho\u1ea3n\\n- G\u1eedi th\u00f4ng b\u00e1o k\u1ebft qu\u1ea3 \u1ee9ng tuy\u1ec3n\&quot; as MailServer #DDD6FE\n}\n\n&#x27; ==========================================\n&#x27; QUAN H\u1ec6 &amp; LU\u1ed2NG \u0110I\u1ec0U H\u01af\u1edaNG\n&#x27; ==========================================\nUI_Student --&gt; C_Student : REST API\nUI_Employer --&gt; C_Employer : REST API\nUI_Admin --&gt; C_Admin : REST API\nUI_Student --&gt; C_Shared : REST &amp; Socket.IO\nUI_Employer --&gt; C_Shared : REST &amp; Socket.IO\n\nC_Student --&gt; MW : Qua ki\u1ec3m tra\nC_Employer --&gt; MW : Qua ki\u1ec3m tra\nC_Admin --&gt; MW : Qua ki\u1ec3m tra\nC_Shared --&gt; MW : Qua ki\u1ec3m tra\n\nMW --&gt; S_Student\nMW --&gt; S_Employer\nMW --&gt; S_Admin\nMW --&gt; S_Shared\n\nS_Student --&gt; R_Student\nS_Employer --&gt; R_Employer\nS_Admin --&gt; R_Admin\nS_Shared --&gt; R_Shared\n\nS_Student --&gt; R_Shared\nS_Employer --&gt; R_Shared\nS_Admin --&gt; R_Shared\n\nR_Student --&gt; DB\nR_Employer --&gt; DB\nR_Admin --&gt; DB\nR_Shared --&gt; DB\n\nS_Shared --&gt; CloudFiles\nS_Shared --&gt; MailServer\n@enduml&quot;, &quot;config&quot;: null}" id="LCA-Root">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>

        <!-- TITLE -->
        <mxCell id="LCA-Title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#065F46;" value="KIẾN TRÚC PHÂN TẦNG CLEAN ARCHITECTURE - PARTIME.VN (CDTN02)&#xa;Mô hình phân chia 3 Role: Sinh viên (Long) | Nhà tuyển dụng (Ngọc) | Quản trị viên (Ngân)" vertex="1">
          <mxGeometry x="100" y="30" width="1000" height="50" as="geometry" />
        </mxCell>

        <!-- LAYER 1: PRESENTATION -->
        <mxCell id="L1-Box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontStyle=1;fontSize=14;fontColor=#065F46;" value="TẦNG 1: TRÌNH BÀY (PRESENTATION LAYER) - ReactJS + Vite + Tailwind CSS + Three.js 3D Logo" vertex="1">
          <mxGeometry x="80" y="100" width="1040" height="200" as="geometry" />
        </mxCell>

        <mxCell id="L1-Student" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=1.5;verticalAlign=top;align=center;fontSize=12;fontColor=#854D0E;" value="&lt;b&gt;Phân hệ SINH VIÊN (Student Portal)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Phụ trách: Vũ Thế Long&lt;/i&gt;&lt;hr&gt;• 3D Interactive Hero &amp; Brand Logo&lt;br&gt;• Tìm kiếm, lọc việc làm, lưu bookmark (FR 1.5)&lt;br&gt;• Quản lý hồ sơ, tạo CV, thư giới thiệu (FR 1.3, 1.4)&lt;br&gt;• Nộp hồ sơ &amp; theo dõi tiến độ (FR 1.6)&lt;br&gt;• Đánh giá NTD, Chat Realtime &amp; Video Call (FR 1.7-1.10)" vertex="1">
          <mxGeometry x="100" y="145" width="310" height="135" as="geometry" />
        </mxCell>

        <mxCell id="L1-Employer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.5;verticalAlign=top;align=center;fontSize=12;fontColor=#9A3412;" value="&lt;b&gt;Phân hệ NHÀ TUYỂN DỤNG (Employer Portal)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Phụ trách: Huỳnh Nguyễn Bảo Ngọc&lt;/i&gt;&lt;hr&gt;• Quản lý hồ sơ công ty, GPKD, Logo/Cover (FR 2.3)&lt;br&gt;• Đăng tin tuyển dụng, sửa, đóng/mở tin (FR 2.4)&lt;br&gt;• Quản lý &amp; duyệt/từ chối ứng viên (FR 2.5)&lt;br&gt;• Đánh giá sinh viên sau hoàn thành việc (FR 2.6)&lt;br&gt;• Chat Realtime, Video Call phỏng vấn (FR 2.7-2.9)" vertex="1">
          <mxGeometry x="445" y="145" width="310" height="135" as="geometry" />
        </mxCell>

        <mxCell id="L1-Admin" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE4E6;strokeColor=#E11D48;strokeWidth=1.5;verticalAlign=top;align=center;fontSize=12;fontColor=#9F1239;" value="&lt;b&gt;Phân hệ QUẢN TRỊ VIÊN (Admin Portal)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Phụ trách: Lê Thị Thuỳ Ngân&lt;/i&gt;&lt;hr&gt;• Dashboard tổng quan số liệu &amp; xuất báo cáo (FR 3.3)&lt;br&gt;• Quản lý người dùng: Khóa/Mở khóa (FR 3.4)&lt;br&gt;• Duyệt/Ẩn tin tuyển dụng vi phạm (FR 3.5)&lt;br&gt;• Quản lý đánh giá chéo &amp; Báo cáo vi phạm (FR 3.6, 3.8)&lt;br&gt;• Quản lý Danh mục &amp; Bộ lọc từ cấm chat (FR 3.7, 3.9)" vertex="1">
          <mxGeometry x="790" y="145" width="310" height="135" as="geometry" />
        </mxCell>

        <!-- LAYER 2: CONTROLLER & API GATEWAY -->
        <mxCell id="L2-Box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontStyle=1;fontSize=14;fontColor=#166534;" value="TẦNG 2: ĐIỀU PHỐI &amp; ĐỊNH TUYẾN (CONTROLLER &amp; API GATEWAY LAYER) - Flask Blueprints" vertex="1">
          <mxGeometry x="80" y="330" width="1040" height="220" as="geometry" />
        </mxCell>

        <mxCell id="L2-MW" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#475569;strokeWidth=1.5;align=center;fontSize=11;fontColor=#1E293B;" value="&lt;b&gt;MIDDLEWARE BẢO MẬT &amp; RÀNG BUỘC TOÀN HỆ THỐNG&lt;/b&gt;&lt;br&gt;• Xác thực JWT (JSON Web Token) &amp; Phân quyền RBAC (Role-based access)&lt;br&gt;• &lt;b style=&quot;color:#DC2626;&quot;&gt;RÀNG BUỘC CỐT LÕI: 1 EMAIL DUY NHẤT CHO 1 ROLE (Không trùng lặp)&lt;/b&gt;&lt;br&gt;• Kiểm tra dữ liệu đầu vào Pydantic, chống injection, giới hạn file upload 10MB" vertex="1">
          <mxGeometry x="100" y="370" width="1000" height="50" as="geometry" />
        </mxCell>

        <mxCell id="L2-CStudent" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=1;fontSize=11;fontColor=#854D0E;" value="&lt;b&gt;Student Blueprints&lt;/b&gt;&lt;br&gt;/api/student/profile&lt;br&gt;/api/student/cv&lt;br&gt;/api/student/jobs&lt;br&gt;/api/student/applications&lt;br&gt;/api/student/reviews" vertex="1">
          <mxGeometry x="100" y="435" width="220" height="95" as="geometry" />
        </mxCell>

        <mxCell id="L2-CEmployer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1;fontSize=11;fontColor=#9A3412;" value="&lt;b&gt;Employer Blueprints&lt;/b&gt;&lt;br&gt;/api/employer/profile&lt;br&gt;/api/employer/jobs&lt;br&gt;/api/employer/applicants&lt;br&gt;/api/employer/reviews" vertex="1">
          <mxGeometry x="360" y="435" width="220" height="95" as="geometry" />
        </mxCell>

        <mxCell id="L2-CAdmin" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE4E6;strokeColor=#E11D48;strokeWidth=1;fontSize=11;fontColor=#9F1239;" value="&lt;b&gt;Admin Blueprints&lt;/b&gt;&lt;br&gt;/api/admin/dashboard&lt;br&gt;/api/admin/users&lt;br&gt;/api/admin/jobs&lt;br&gt;/api/admin/categories&lt;br&gt;/api/admin/reports&lt;br&gt;/api/admin/banned-words" vertex="1">
          <mxGeometry x="620" y="435" width="220" height="95" as="geometry" />
        </mxCell>

        <mxCell id="L2-CShared" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;strokeWidth=1;fontSize=11;fontColor=#3730A3;" value="&lt;b&gt;Core &amp; Realtime Gateways&lt;/b&gt;&lt;br&gt;/api/auth (Login, Register, OTP)&lt;br&gt;Socket.IO /socket.io/&lt;br&gt;WebRTC Signaling Relay&lt;br&gt;/api/notifications" vertex="1">
          <mxGeometry x="880" y="435" width="220" height="95" as="geometry" />
        </mxCell>

        <!-- LAYER 3: APPLICATION SERVICES -->
        <mxCell id="L3-Box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontStyle=1;fontSize=14;fontColor=#1E293B;" value="TẦNG 3: NGHIỆP VỤ HỆ THỐNG (APPLICATION &amp; BUSINESS LOGIC SERVICES)" vertex="1">
          <mxGeometry x="80" y="580" width="1040" height="180" as="geometry" />
        </mxCell>

        <mxCell id="L3-SStudent" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=1;fontSize=11;fontColor=#854D0E;" value="&lt;b&gt;Student Services (Vũ Thế Long)&lt;/b&gt;&lt;br&gt;• StudentProfileService (Hồ sơ, thư gt)&lt;br&gt;• ResumeService (Upload &amp; Set default)&lt;br&gt;• JobSearchService (Lọc, Bookmark)&lt;br&gt;• ApplicationService (Chặn nộp trùng)&lt;br&gt;• StudentReviewService" vertex="1">
          <mxGeometry x="100" y="625" width="220" height="115" as="geometry" />
        </mxCell>

        <mxCell id="L3-SEmployer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1;fontSize=11;fontColor=#9A3412;" value="&lt;b&gt;Employer Services (Huỳnh Nguyễn Bảo Ngọc)&lt;/b&gt;&lt;br&gt;• CompanyService (GPKD, profile)&lt;br&gt;• JobManageService (Lifecycle tin)&lt;br&gt;• ApplicantService (Duyệt/Từ chối hồ sơ)&lt;br&gt;• EmployerReviewService" vertex="1">
          <mxGeometry x="360" y="625" width="220" height="115" as="geometry" />
        </mxCell>

        <mxCell id="L3-SAdmin" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE4E6;strokeColor=#E11D48;strokeWidth=1;fontSize=11;fontColor=#9F1239;" value="&lt;b&gt;Admin Services (Lê Thị Thuỳ Ngân)&lt;/b&gt;&lt;br&gt;• AnalyticsService (Thống kê tăng trưởng)&lt;br&gt;• UserModerationService (Khóa/Mở user)&lt;br&gt;• JobModerationService (Ẩn/Hiện tin)&lt;br&gt;• MasterDataService (Quản lý ngành nghề)&lt;br&gt;• BannedKeywordService" vertex="1">
          <mxGeometry x="620" y="625" width="220" height="115" as="geometry" />
        </mxCell>

        <mxCell id="L3-SShared" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;strokeWidth=1;fontSize=11;fontColor=#3730A3;" value="&lt;b&gt;Core Shared Services&lt;/b&gt;&lt;br&gt;• AuthService (Email uniqueness check)&lt;br&gt;• RealtimeChatService (Filter bad words)&lt;br&gt;• NotificationPushService&lt;br&gt;• MediaStorageService (Cloudinary)" vertex="1">
          <mxGeometry x="880" y="625" width="220" height="115" as="geometry" />
        </mxCell>

        <!-- LAYER 4: DATA ACCESS / REPOSITORY -->
        <mxCell id="L4-Box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#334155;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontStyle=1;fontSize=14;fontColor=#0F172A;" value="TẦNG 4: TRUY XUẤT DỮ LIỆU (DATA ACCESS / REPOSITORY LAYER) - Mẫu Repository" vertex="1">
